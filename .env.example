# =============================================================================
# ShubhDigi Admin — environment
# =============================================================================
# Auth cookies (sd_access_token / sd_refresh_token) must be set on the ADMIN host.
# Always use the same-origin proxy path in the browser — never point the client
# at the absolute API URL in production.

# REQUIRED (browser): same-origin proxy prefix. Axios baseURL.
NEXT_PUBLIC_API_URL=/api/backend

# REQUIRED (server-only): Backend origin ONLY — no trailing slash, no /api,
# no /api/backend. Used by the Route Handler (and rewrite fallback).
BACKEND_URL=http://localhost:5001

# Optional public admin origin (local / docs)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Production (Vercel → admin.shubhdigi.in) ---
# Set BOTH of these on the Vercel project (Production) exactly:
#   NEXT_PUBLIC_API_URL=/api/backend
#   BACKEND_URL=https://website-backend-m8si.onrender.com
#
# Do NOT put /api or /api/backend on BACKEND_URL.
# Do NOT set NEXT_PUBLIC_API_URL to https://… — that hits Render as
# /api/backend/auth/login (404) and cookies stick to the API host.
#
# On the Backend host, also verify:
#   ADMIN_URL=https://admin.shubhdigi.in
#   COOKIE_DOMAIN=          (empty / unset — host-only via proxy)
#   COOKIE_SAMESITE=lax
#   COOKIE_SECURE=true
#   JWT_ACCESS_EXPIRES=7d
#   JWT_REFRESH_EXPIRES=30d
#   JWT_REFRESH_EXPIRES_SHORT=7d
# Session lasts until logout (or refresh TTL). Restart Backend after JWT env changes;
# existing sessions need a fresh login to pick up new cookie/JWT lifetimes.

# ImageKit — PUBLIC values only (safe for NEXT_PUBLIC_*)
# Private key must NEVER be set here; it lives only in Backend/.env
IMAGEKIT_ID=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# Cache invalidation is Backend-bridged. Do NOT set REVALIDATE_SECRET here.
# Admin never calls the public /api/revalidate endpoint.
