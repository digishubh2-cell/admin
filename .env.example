# =============================================================================
# ShubhDigi Admin — environment
# =============================================================================
# Auth cookies (sd_access_token / sd_refresh_token) must be set on the ADMIN host.
# Always use the same-origin proxy path in the browser — never point the client
# at the absolute API URL in production.

# REQUIRED (browser): same-origin proxy prefix. Axios baseURL.
NEXT_PUBLIC_API_URL=/api/backend

# REQUIRED (server-only): Backend origin, NO trailing slash, NO /api suffix.
# Used by src/app/api/backend/[...path]/route.ts (and rewrite fallback).
BACKEND_URL=http://localhost:5001

# Optional public admin origin (local / docs)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Production (Vercel → admin.shubhdigi.in) ---
# Set BOTH of these on the Vercel project (Production):
#   NEXT_PUBLIC_API_URL=/api/backend
#   BACKEND_URL=https://<your-api-host>
#
# Do NOT set NEXT_PUBLIC_API_URL to https://api... — cookies would stick to the
# API host and middleware would bounce / → /login?redirect=/ after a "successful" login.
#
# On the Backend host, also verify:
#   ADMIN_URL=https://admin.shubhdigi.in
#   COOKIE_DOMAIN=          (empty / unset — host-only via proxy)
#   COOKIE_SAMESITE=lax
#   COOKIE_SECURE=true

# ImageKit — PUBLIC values only (safe for NEXT_PUBLIC_*)
# Private key must NEVER be set here; it lives only in Backend/.env
IMAGEKIT_ID=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
